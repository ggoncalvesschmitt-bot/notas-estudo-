<!DOCTYPE html>

<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HTML Exemplo</title>
</head>
<body>
      <!-- Cabeçalho -->
    <header>
        <h1>top 10 memes  </h1>
    </header>

    <!-- Corpo da página -->
    <main>
        <section>
            <h2></h2>
            <div class="container">

                <!-- Lista não ordenada -->
                <div>
                    <h3>:</h3>
                    <ul>
                        <li>Item 1</li>
                        <li>Item 2</li>
                        <li>Item 3</li>
                    </ul>
                </div>

                <!-- Lista ordenada -->
                <div>
                    <h3>Lista ordenada:</h3>
                    <ol>
                        <li>Primeiro item</li>
                        <li>Segundo item</li>
                        <li>Terceiro item</li>
                    </ol>
                </div>
            </div>
        </section>

</body>
</html>
